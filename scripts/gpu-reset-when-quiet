#!/usr/bin/env bash
# gpu-reset-when-quiet -- wait until no job is using any NVIDIA GPU, then reset every GPU.
#
# For a shared server with a failed GPU (an idle card that answers "busy or unavailable", an Xid
# that leaves "GPU Reset Required"): start it as root and walk away.
#
#   sudo scripts/gpu-reset-when-quiet [--interval SECS] [--max-wait SECS] [--reload] [--dry-run]
#
# 1. WAIT.  Every --interval seconds (default 10) it lists the processes holding an NVIDIA device
#    file (/dev/nvidia*, and the NVIDIA /dev/dri nodes), plus every PID the driver still reports as
#    a compute client (a process that is exiting has an empty fd table but still holds the card).
#    It proceeds when the only holders left are nvtop sessions and the GPU services below.
# 2. CLEAR.  It terminates each nvtop and tells its owner on that terminal: "nvtop was terminated to
#    reset a failed GPU".  It records which GPUs have persistence mode on and turns it off, and stops
#    the GPU services that are running: the display manager (gdm), nvidia-persistenced, DCGM and
#    Fabric Manager.
# 3. RESET.  nvidia-smi -r on each GPU by bus ID.  If a GPU cannot be reset that way ("Not
#    Supported", a hung firmware) -- or with --reload -- it unloads the NVIDIA modules, gives every
#    GPU a PCI function-level reset, reloads the modules in boot order, and re-creates any
#    /dev/nvidia* node whose major number changed (dynamic majors are handed out in load order, and
#    a stale /dev/nvidia-uvm left CUDA failing with error 999 everywhere once).
# 4. RESTORE + VERIFY.  Services restarted, persistence restored, then a CUDA context on every GPU
#    (as root, CUDA_VISIBLE_DEVICES=<uuid>) and its row-remap state.
#
# If a job starts between the check and the reset (the reset then says "In use by another client",
# or a module will not unload), everything it changed is put back and it returns to waiting.  An
# interrupt or error after step 2 does the same.
#
# Exit: 0 every GPU reset and answers CUDA; 1 a GPU still fails or the driver could not be reloaded
# (a warm reboot is next); 2 usage; 3 --max-wait expired.
#
# --dry-run: one scan, then what it would do right now; changes nothing.  It runs without root, but
# then it sees only your own processes' device files (the driver's compute-client list still shows
# everyone's jobs).
#
# Only nvtop is terminated.  Any other monitor (nvidia-smi -l, nvitop, gpustat, a framework polling
# NVML) holds every card's device file, and the script waits for it like any job; its log line names
# it.  Messages also go to syslog (tag gpu-reset-when-quiet).

set -uo pipefail

INTERVAL=10
MAX_WAIT=0
FORCE_RELOAD=0
DRY_RUN=0
TAG=gpu-reset-when-quiet
KILLABLE_COMM=nvtop

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 2; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--interval) INTERVAL=${2:?}; shift 2 ;;
    --max-wait)    MAX_WAIT=${2:?}; shift 2 ;;
    --reload)      FORCE_RELOAD=1; shift ;;
    -n|--dry-run)  DRY_RUN=1; shift ;;
    -h|--help)     usage ;;
    *) echo "$TAG: unknown option: $1" >&2; usage ;;
  esac
done
[[ "$INTERVAL" =~ ^[0-9]+$ && "$INTERVAL" -ge 1 ]] || { echo "$TAG: --interval wants seconds >= 1" >&2; exit 2; }
[[ "$MAX_WAIT" =~ ^[0-9]+$ ]] || { echo "$TAG: --max-wait wants seconds" >&2; exit 2; }

log() {
  printf '%s %s\n' "$(date '+%F %T')" "$*"
  # Under systemd (e.g. systemd-run) stdout already is the journal; a logger copy would double every line.
  [[ -n "${JOURNAL_STREAM:-}" ]] || logger -t "$TAG" -- "$*" 2>/dev/null || true
}
die() { log "ERROR: $*"; exit 1; }

if [[ $EUID -ne 0 ]]; then
  [[ $DRY_RUN -eq 1 ]] || { echo "$TAG: must run as root (or with --dry-run)" >&2; exit 2; }
  log "dry run without root: only YOUR processes' device files are visible (the driver's compute-client list still shows everyone's jobs)"
fi

for t in nvidia-smi find modprobe systemctl timeout; do
  command -v "$t" >/dev/null 2>&1 || { echo "$TAG: $t not found" >&2; exit 2; }
done

# One instance at a time.
LOCK=/run/lock/$TAG.lock; [[ $EUID -eq 0 ]] || LOCK=${TMPDIR:-/tmp}/$TAG.$EUID.lock
exec 9>"$LOCK" || exit 2
flock -n 9 || { echo "$TAG: another instance is running ($LOCK)" >&2; exit 2; }

NVSMI() { timeout 60 nvidia-smi "$@"; }   # a broken GPU can make a query hang

# ---- inventory ------------------------------------------------------------------------------
# GPUs: every PCI function bound to the nvidia driver (sysfs works even when nvidia-smi does not).
mapfile -t GPUS < <(ls -d /sys/bus/pci/drivers/nvidia/[0-9a-f]*:*:*.* 2>/dev/null | xargs -rn1 basename | sort)
[[ ${#GPUS[@]} -gt 0 ]] || die "no PCI device is bound to the nvidia driver"
smi_bus() { local id=${1^^}; printf '0000%s' "$id"; }   # 0000:61:00.0 -> 00000000:61:00.0

# The NVIDIA DRM nodes (the BMC's VGA card has its own; leave its users alone).
declare -A NV_DRI=()
for n in /sys/class/drm/card[0-9]* /sys/class/drm/renderD[0-9]*; do
  [[ "$(basename "$n")" =~ ^(card|renderD)[0-9]+$ ]] || continue
  [[ "$(basename "$(readlink -f "$n/device/driver" 2>/dev/null)")" == nvidia ]] && NV_DRI[/dev/dri/$(basename "$n")]=1
done

# GPU services, in stop order (display manager first: its X server holds the DRM nodes).
DM=$(systemctl show -p Id --value display-manager.service 2>/dev/null)
CANDIDATES=("$DM" nvidia-dcgm.service dcgm.service nvidia-fabricmanager.service nvidia-persistenced.service)
SERVICE_UNITS=()
for u in "${CANDIDATES[@]}"; do
  [[ -n "$u" ]] || continue
  [[ " ${SERVICE_UNITS[*]} " == *" $u "* ]] && continue
  SERVICE_UNITS+=("$u")
done
GDM_UID=$(id -u gdm 2>/dev/null || id -u Debian-gdm 2>/dev/null || echo -1)

# ---- who holds the GPUs ---------------------------------------------------------------------
# Prints one line per holder: PID TAB USER TAB COMM TAB CLASS TAB TTY.
# CLASS: nvtop | service (stopped by this script) | job (waited for).
is_service_proc() {
  local pid=$1 comm=$2 uid
  uid=$(stat -c %u "/proc/$pid" 2>/dev/null) || return 1
  [[ "$uid" == "$GDM_UID" ]] && return 0                 # gdm's greeter session
  [[ "$comm" == Xorg || "$comm" == Xwayland ]] && return 0
  local u cg
  cg=$(cat "/proc/$pid/cgroup" 2>/dev/null) || return 1
  for u in "${SERVICE_UNITS[@]}"; do [[ "$cg" == *"/$u"* ]] && return 0; done
  return 1
}
scan_holders() {
  declare -A seen=()
  local dir target pid
  while IFS=$'\t' read -r dir target; do
    pid=${dir#/proc/}; pid=${pid%/fd}
    [[ "$pid" == "$$" ]] && continue
    if [[ "$target" == /dev/dri/* ]]; then [[ -n "${NV_DRI[$target]:-}" ]] || continue; fi
    seen[$pid]=1
  done < <(find /proc/[0-9]*/fd -maxdepth 1 -type l \( -lname '/dev/nvidia*' -o -lname '/dev/dri/*' \) \
             -printf '%h\t%l\n' 2>/dev/null)
  # The driver's own client list: catches a process that is exiting (fd table already empty).
  while read -r pid; do
    [[ "$pid" =~ ^[0-9]+$ ]] && seen[$pid]=1
  done < <(NVSMI --query-compute-apps=pid --format=csv,noheader 2>/dev/null)
  local comm user tty class
  for pid in "${!seen[@]}"; do
    comm=$(cat "/proc/$pid/comm" 2>/dev/null) || comm="(exiting)"
    user=$(stat -c %U "/proc/$pid" 2>/dev/null) || user="?"
    tty=$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' '); tty=${tty:-?}
    if [[ "$comm" == "$KILLABLE_COMM" ]]; then class=nvtop
    elif [[ "$comm" != "(exiting)" ]] && is_service_proc "$pid" "$comm"; then class=service
    else class=job; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$pid" "$user" "$comm" "$class" "$tty"
  done
}
summarize() {   # "user: comm xN, ..." for the given class
  awk -F'\t' -v c="$1" '$4==c {n[$2": "$3]++} END {s=""; for (k in n) s = s (s?", ":"") k " x" n[k]; print s}'
}

# ---- state restore (also on interrupt) ------------------------------------------------------
STOPPED=()        # units this script stopped
PM_OFF=()         # nvidia-smi bus IDs whose persistence mode this script turned off
REMOVED=()        # modules this script unloaded and has not reloaded
MOD_LOAD_ORDER=(nvidia nvidia_fs nvidia_uvm nvidia_peermem nvidia_modeset nvidia_drm)
MOD_UNLOAD_ORDER=(nvidia_drm nvidia_modeset nvidia_peermem nvidia_uvm nvidia_fs nvidia)

reload_modules() {
  local m r
  for m in "${MOD_LOAD_ORDER[@]}"; do
    for r in "${REMOVED[@]}"; do
      [[ "$r" == "$m" ]] || continue
      if modprobe "$m"; then log "loaded $m"; else log "WARNING: modprobe $m failed"; fi
    done
  done
  REMOVED=()
  fix_dev_nodes
}

# Re-create a /dev node whose major no longer matches /proc/devices (dynamic majors follow load
# order).  Minor, mode and owner are kept.  /dev/nvidia-uvm is created if missing.
fix_dev_nodes() {
  declare -A maj=()
  local m name
  while read -r m name; do [[ "$m" =~ ^[0-9]+$ ]] && maj[$name]=$m; done < <(sed -n '/^Character devices:/,/^$/p' /proc/devices)
  local path drv cur min mode own grp
  for path in /dev/nvidia[0-9]* /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm /dev/nvidia-uvm-tools \
              /dev/nvidia-fs* /dev/nvidia-caps/* /dev/nvidia-caps-imex-channels/*; do
    [[ -c "$path" ]] || continue
    case "$path" in
      /dev/nvidia-uvm*)                      drv=nvidia-uvm ;;
      /dev/nvidia-fs*)                       drv=nvidia-fs ;;
      /dev/nvidia-caps-imex-channels/*)      drv=nvidia-caps-imex-channels ;;
      /dev/nvidia-caps/*)                    drv=nvidia-caps ;;
      *)                                     drv=nvidia ;;
    esac
    [[ -n "${maj[$drv]:-}" ]] || continue
    cur=$((16#$(stat -c %t "$path"))); min=$((16#$(stat -c %T "$path")))
    [[ "$cur" -eq "${maj[$drv]}" ]] && continue
    mode=$(stat -c %a "$path"); own=$(stat -c %u "$path"); grp=$(stat -c %g "$path")
    if rm -f "$path" && mknod -m "$mode" "$path" c "${maj[$drv]}" "$min" && chown "$own:$grp" "$path"; then
      log "re-created $path: major $cur -> ${maj[$drv]} (minor $min)"
    else
      log "WARNING: could not re-create $path (c ${maj[$drv]} $min)"
    fi
  done
  if [[ -n "${maj[nvidia-uvm]:-}" && ! -e /dev/nvidia-uvm ]]; then
    mknod -m 666 /dev/nvidia-uvm c "${maj[nvidia-uvm]}" 0 && log "created /dev/nvidia-uvm"
    mknod -m 666 /dev/nvidia-uvm-tools c "${maj[nvidia-uvm]}" 1 && log "created /dev/nvidia-uvm-tools"
  fi
}

restore_all() {
  [[ ${#REMOVED[@]} -gt 0 ]] && reload_modules
  local i
  for (( i=${#STOPPED[@]}-1; i>=0; i-- )); do
    if systemctl start "${STOPPED[$i]}"; then log "started ${STOPPED[$i]}"; else log "WARNING: could not start ${STOPPED[$i]}"; fi
  done
  STOPPED=()
  local b
  for b in "${PM_OFF[@]}"; do
    NVSMI -i "$b" -pm 1 >/dev/null 2>&1 && log "persistence mode back on: $b" || log "WARNING: could not restore persistence mode on $b"
  done
  PM_OFF=()
}
trap 'rc=$?; restore_all; exit $rc' EXIT
trap 'log "interrupted"; exit 130' INT TERM

# ---- the reset ------------------------------------------------------------------------------
kill_nvtop() {   # stdin: holder lines
  local pid user comm class tty i msg
  msg="nvtop was terminated to reset a failed GPU on $(hostname -s) at $(date '+%H:%M'). It can be started again once the reset is done (a few minutes)."
  while IFS=$'\t' read -r pid user comm class tty; do
    [[ "$class" == nvtop ]] || continue
    kill -TERM "$pid" 2>/dev/null
    for i in $(seq 1 10); do [[ -d /proc/$pid ]] || break; sleep 0.5; done
    [[ -d /proc/$pid ]] && kill -KILL "$pid" 2>/dev/null
    log "terminated nvtop PID $pid ($user, ${tty})"
    if [[ "$tty" != "?" && -c /dev/$tty ]]; then
      printf '%s\n' "$msg" | timeout 5 write "$user" "$tty" >/dev/null 2>&1 \
        || printf '\r\n*** %s ***\r\n' "$msg" > "/dev/$tty" 2>/dev/null \
        || log "WARNING: could not message $user on $tty"
    fi
  done
}

stop_services() {
  local u
  for u in "${SERVICE_UNITS[@]}"; do
    systemctl is-active --quiet "$u" 2>/dev/null || continue
    if systemctl stop "$u"; then STOPPED+=("$u"); log "stopped $u"; else log "WARNING: could not stop $u"; fi
  done
  # Their processes (gdm's greeter session, X) can take a moment to go.
  local i
  for i in $(seq 1 30); do
    scan_holders | awk -F'\t' '$4=="service"' | grep -q . || return 0
    sleep 1
  done
  log "WARNING: service processes still hold GPUs: $(scan_holders | summarize service)"
}

persistence_off() {
  local bus pm
  while IFS=', ' read -r bus pm; do
    [[ "$pm" == Enabled ]] || continue
    if NVSMI -i "$bus" -pm 0 >/dev/null 2>&1; then PM_OFF+=("$bus"); log "persistence mode off: $bus"; fi
  done < <(NVSMI --query-gpu=pci.bus_id,persistence_mode --format=csv,noheader 2>/dev/null)
}

# 0 all reset; 1 a GPU in use (a job raced us); 2 a GPU that nvidia-smi cannot reset
smi_reset_all() {
  local id bus out rc=0
  for id in "${GPUS[@]}"; do
    bus=$(smi_bus "$id")
    out=$(timeout 180 nvidia-smi -r -i "$bus" 2>&1); local r=$?
    if [[ $r -eq 0 ]]; then log "reset $bus"; continue; fi
    log "nvidia-smi -r $bus failed: $(tr '\n' ' ' <<<"$out" | cut -c1-200)"
    if grep -qi 'in use' <<<"$out"; then return 1; fi
    rc=2
  done
  return $rc
}

# 0 reloaded; 1 a module would not unload (a client remains); 2 reloaded but GPUs are missing
driver_reload() {
  local m loaded=() id
  for m in "${MOD_UNLOAD_ORDER[@]}"; do [[ -d /sys/module/$m ]] && loaded+=("$m"); done
  for m in "${loaded[@]}"; do
    if modprobe -r "$m"; then REMOVED+=("$m"); log "unloaded $m"
    else
      log "could not unload $m (refcnt $(cat /sys/module/$m/refcnt 2>/dev/null)); holders: $(scan_holders | summarize job) $(scan_holders | summarize service)"
      reload_modules
      return 1
    fi
  done
  for id in "${GPUS[@]}"; do
    if [[ -w /sys/bus/pci/devices/$id/reset ]] && echo 1 > "/sys/bus/pci/devices/$id/reset" 2>/dev/null; then
      log "PCI reset $id ($(cat /sys/bus/pci/devices/$id/reset_method 2>/dev/null))"
    else
      log "WARNING: PCI reset of $id failed"
    fi
  done
  reload_modules
  local n
  n=$(NVSMI -L 2>/dev/null | grep -c '^GPU ')
  log "driver reloaded: nvidia-smi lists $n of ${#GPUS[@]} GPUs"
  [[ "$n" -eq ${#GPUS[@]} ]] || return 2
  return 0
}

verify() {
  local py=/usr/bin/python3 bus uuid ok=0 bad=0 res pend
  while IFS=', ' read -r bus uuid; do
    if [[ -x "$py" ]]; then
      res=$(CUDA_VISIBLE_DEVICES=$uuid timeout 60 "$py" -I -c '
import ctypes, sys
cu = ctypes.CDLL("libcuda.so.1")
r = cu.cuInit(0)
if r: print("cuInit error %d" % r); sys.exit(1)
d = ctypes.c_int(0); ctx = ctypes.c_void_p()
r = cu.cuDeviceGet(ctypes.byref(d), 0) or cu.cuCtxCreate_v2(ctypes.byref(ctx), 0, d)
print("CUDA context ok" if r == 0 else "CUDA error %d" % r); sys.exit(1 if r else 0)' 2>&1) && ok=$((ok+1)) || bad=$((bad+1))
    else
      res="(no /usr/bin/python3: CUDA check skipped)"
    fi
    pend=$(NVSMI -q -i "$bus" 2>/dev/null | grep -A6 'Remapped Rows' | grep -m1 'Pending' | awk -F: '{gsub(/ /,"",$2); print $2}')
    log "  $bus: ${res}; row remap pending: ${pend:-?}"
  done < <(NVSMI --query-gpu=pci.bus_id,uuid --format=csv,noheader 2>/dev/null)
  log "verify: $ok GPU(s) answer CUDA, $bad do not"
  [[ $bad -eq 0 ]]
}

# ---- main -----------------------------------------------------------------------------------
log "watching ${#GPUS[@]} GPUs (${GPUS[*]}), every ${INTERVAL}s; services: ${SERVICE_UNITS[*]}"
start=$(date +%s); last_msg=""; last_t=0
while true; do
  H=$(scan_holders)
  jobs=$(summarize job <<<"$H")
  if [[ $DRY_RUN -eq 1 ]]; then
    log "dry run -- holders now:"
    [[ -n "$H" ]] && while IFS=$'\t' read -r p u c cl t; do log "  PID $p  $u  $c  [$cl]  tty $t"; done <<<"$H"
    if [[ -n "$jobs" ]]; then log "dry run: would keep waiting for: $jobs"
    else
      log "dry run: would terminate nvtop: $(summarize nvtop <<<"$H")"
      log "dry run: would stop: $(for u in "${SERVICE_UNITS[@]}"; do systemctl is-active --quiet "$u" && printf '%s ' "$u"; done)"
      log "dry run: would reset: ${GPUS[*]}$([[ $FORCE_RELOAD -eq 1 ]] && echo ' (driver reload)')"
    fi
    exit 0
  fi
  if [[ -n "$jobs" ]]; then
    now=$(date +%s)
    if [[ "$jobs" != "$last_msg" || $((now - last_t)) -ge 300 ]]; then
      log "waiting: GPUs in use by $jobs"; last_msg=$jobs; last_t=$now
    fi
    if [[ $MAX_WAIT -gt 0 && $((now - start)) -ge $MAX_WAIT ]]; then log "gave up after ${MAX_WAIT}s"; exit 3; fi
    sleep "$INTERVAL"; continue
  fi

  log "quiet: no job holds a GPU$( n=$(summarize nvtop <<<"$H"); [[ -n "$n" ]] && echo "; nvtop: $n")"
  kill_nvtop <<<"$H"
  persistence_off
  stop_services
  # A job that started meanwhile wins: put everything back and wait again.
  jobs=$(scan_holders | summarize job)
  if [[ -n "$jobs" ]]; then
    log "a job started meanwhile ($jobs): restoring and waiting again"
    restore_all; sleep "$INTERVAL"; continue
  fi

  need_reload=$FORCE_RELOAD
  if [[ $FORCE_RELOAD -eq 0 ]]; then
    smi_reset_all; r=$?
    if [[ $r -eq 1 ]]; then log "a GPU was in use: restoring and waiting again"; restore_all; sleep "$INTERVAL"; continue; fi
    [[ $r -eq 2 ]] && need_reload=1
  fi
  if [[ $need_reload -eq 1 ]]; then
    log "reloading the NVIDIA driver"
    driver_reload; r=$?
    if [[ $r -eq 1 ]]; then
      jobs=$(scan_holders | summarize job)
      if [[ -n "$jobs" ]]; then log "a job holds the driver ($jobs): restoring and waiting again"; restore_all; sleep "$INTERVAL"; continue; fi
      die "the driver would not unload with no job holding it; a warm reboot is next"
    fi
    [[ $r -eq 2 ]] && log "WARNING: not every GPU came back after the reload; a warm reboot is next"
  fi
  restore_all
  verify && { log "done: every GPU reset and answers CUDA"; exit 0; }
  log "done, but a GPU still fails (above); --reload, then a warm reboot, then a cold power cycle"
  exit 1
done
